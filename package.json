{
  "name": "mini-cast",
  "version": "0.11.0",
  "type": "module",
  "author": "안동민",
  "main": "dist/electron/main.js",
  "description": "키보드·마우스 시각화 및 화면 판서 오버레이",
  "scripts": {
    "dev": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run build:electron && electron .",
    "app": "concurrently -k \"npm run dev\" \"wait-on tcp:127.0.0.1:3000 && npm run electron:dev\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run build:electron && node --test \"tests/unit/**/*.test.mjs\"",
    "smoke": "vite build && npm run build:electron && electron . --smoke-test",
    "build": "npm run typecheck && vite build && npm run build:electron && electron-builder --publish never",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm test && npm run lint"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.11",
    "clsx": "^2.1.1",
    "electron-store": "^11.0.2",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "electron": "44.1.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "MiniCast",
    "productName": "MiniCast",
    "copyright": "Copyright © andongmin",
    "icon": "public/icon.ico",
    "mac": {
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "msi",
        "portable"
      ]
    },
    "msi": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    },
    "files": [
      "public/**/*",
      "dist/**/*"
    ],
    "directories": {
      "output": "output"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/prebuilds/**/*"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "uiohook-napi@1.5.5": true,
    "electron@44.1.0": true
  }
}
